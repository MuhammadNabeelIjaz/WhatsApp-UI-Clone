# ============================================================
# .gitignore — WhatsApp Clone
# Stack: React 19 + Vite 7 + TypeScript (JS/JSX) + Tailwind v4
#        + Redux Toolkit + Framer Motion
# ============================================================

# ------------------------------
# Dependencies
# ------------------------------
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ------------------------------
# Build output
# ------------------------------
dist/
dist-ssr/
build/
*.local

# ------------------------------
# Environment variables
# ------------------------------
# .env, .env.development, .env.production are TRACKED on purpose —
# they only hold non-secret build flags (VITE_LOG_LEVEL, VITE_APP_ENV).
# Only local overrides (often machine-specific / contain real secrets) are ignored:
.env.local
.env.*.local
.env.development.local
.env.production.local
.env.test.local

# ------------------------------
# Vite
# ------------------------------
.vite/
*.timestamp-*.mjs
*.timestamp-*.cjs

# ------------------------------
# TypeScript
# ------------------------------
*.tsbuildinfo

# ------------------------------
# Logs
# ------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------
# Testing / Coverage (future-proof)
# ------------------------------
coverage/
*.lcov
.nyc_output/

# ------------------------------
# Cache
# ------------------------------
.eslintcache
.cache/
.parcel-cache/
.npm/

# ------------------------------
# Editor / IDE
# ------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# JetBrains (WebStorm / IntelliJ)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs swap & backup files
*.swp
*.swo
*~

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------
# OS generated files
# ------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ------------------------------
# Misc
# ------------------------------
*.bak
*.tmp
*.temp
.history/
